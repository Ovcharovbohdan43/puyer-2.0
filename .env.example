# App (production must be the public origin, not localhost)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Personal access token for npm run auth:push-templates only (Account → Access Tokens).
# Not used by the Next.js app. Never prefix with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=

# Supabase public — Connect dialog or Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Settings → API Keys → Secret keys (sb_secret_...) or Legacy service_role.
# Server only. Never prefix with NEXT_PUBLIC_. Needed to cache generated PDFs in Storage.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — green Connect button at the top of the project (not Settings → Database).
# DATABASE_URL = ORMs / Transaction pooler, port 6543. Append ?pgbouncer=true
# DIRECT_URL  = Session pooler, port 5432 (Windows/IPv4; do not use db.*.supabase.co)
DATABASE_URL=postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Stripe — test mode only in development
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET_PLATFORM=
STRIPE_WEBHOOK_SECRET_CONNECT=
STRIPE_PLATFORM_PRICE_PRO=
STRIPE_PLATFORM_PRICE_PRO_YEARLY=
STRIPE_PLATFORM_PRICE_BUSINESS=
STRIPE_PLATFORM_PRICE_BUSINESS_YEARLY=
STRIPE_API_VERSION=2026-02-25.clover

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local only: set to 1 so /api/inngest works without a cloud signing key
INNGEST_DEV=

# Email — Resend (invoices, reminders, team invites, Auth Send Email hook)
RESEND_API_KEY=
EMAIL_FROM=
# Reminders (invoice drawer + Inngest). Must be a verified Resend domain.
EMAIL_FROM_REMINDERS=Puyer Reminders <reminders@puyer.org>
# Supabase Dashboard → Authentication → Hooks → Send Email → Generate Secret
# Paste the full value (v1,whsec_...). Hook URL: https://<host>/api/auth/send-email
SEND_EMAIL_HOOK_SECRET=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
